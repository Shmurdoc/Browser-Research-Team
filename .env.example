# ============================================================
# Design Pattern Multiverse Configuration
# ============================================================
#
# IMPORTANT: Copy this file to .env and fill in values.
# NEVER commit .env to version control — it contains secrets!
#
# ============================================================

# Logging
DPM_LOG_LEVEL=info
DPM_LOG_DIR=./logs

# Storage
DPM_STORAGE_DIR=./patterns

# OpenAI (required for vision analysis and code generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vision & Code Generation Models
# gpt-4o-mini is recommended (fast, cheap, high quality)
VISION_MODEL=gpt-4o-mini
CODE_GEN_MODEL=gpt-4o-mini
VISION_MAX_TOKENS=2048
CODE_GEN_MAX_TOKENS=4096
CODE_GEN_TEMPERATURE=0.2
API_TIMEOUT_MS=30000

# Embedding Provider (local = @xenova/transformers, openai = text-embedding-3-small)
EMBEDDING_PROVIDER=local

# Design Data APIs (optional, at least one recommended for real data)
# Pinterest API v5: https://developers.pinterest.com/
PINTEREST_API_KEY=

# Dribbble API v2: https://developer.dribbble.com/
DRIBBBLE_API_KEY=

# Behance API: https://www.behance.net/dev
BEHANCE_API_KEY=

# Figma API: https://www.figma.com/developers/api
FIGMA_ACCESS_TOKEN=

# Supabase (optional, for cloud storage)
SUPABASE_URL=
SUPABASE_KEY=

# MCP Server Authentication
DPM_MCP_KEY=

# Image Processing
DPM_ENABLE_IMAGE_DOWNLOAD=true

# SONA Learning
SONA_ADAPTATION_RATE=0.15

# Router (Q-Learning)
DPM_ROUTER_STATE=./patterns/router-state.json

# Security
DPM_RATE_LIMIT_PER_MINUTE=100
DPM_RATE_LIMIT_PER_HOUR=1000

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000

# Development
NODE_ENV=development
