{
  "name": "design-pattern-multiverse",
  "version": "1.0.0",
  "description": "Self-learning multi-agent system that researches design patterns from the internet, interprets UI/UX through computer vision, catalogs them into a living pattern library, and recursively improves using swarm intelligence.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp-server/index.js",
      "types": "./dist/mcp-server/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/cli/index.d.ts"
    }
  },
  "bin": {
    "dpm": "dist/cli/index.js",
    "dpm-mcp": "dist/mcp-server/index.js",
    "dpm-web": "dist/web-server/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "web": "node dist/web-server/index.js",
    "dev:web": "tsx src/web-server/index.ts",
    "mcp": "node dist/mcp-server/index.js",
    "mcp-server": "node dist/mcp-server/index.js",
    "mcp-start": "npm run build && npm run mcp-server",
    "dev": "tsx src/cli/index.ts",
    "dev:mcp": "tsx src/mcp-server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "postinstall": "npx playwright install chromium --with-deps 2>/dev/null || true",
    "setup": "npm run build && npx playwright install chromium"
  },
  "keywords": [
    "design-patterns",
    "ui-ux",
    "mcp",
    "model-context-protocol",
    "opencode",
    "swarm",
    "multi-agent",
    "design-system",
    "pattern-library"
  ],
  "author": "rUv + gstack",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@xenova/transformers": "^2.17.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "figlet": "^1.8.0",
    "nanoid": "^5.1.5",
    "openai": "^4.85.0",
    "ora": "^8.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "protobufjs": "^7.4.0"
  }
}
